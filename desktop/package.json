{
  "name": "simpletube",
  "productName": "SimpleTube",
  "version": "2.0.5",
  "description": "A quiet place to save your favourite moments.",
  "main": "main.js",
  "author": "JojoChicken",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
